# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). Expo inlines EXPO_PUBLIC_* variables into the
# client bundle at build time, so restart `expo start` after changing them.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The anon key ships inside the app and is public by design -- that is only
# safe when Row Level Security is enabled on every table it can reach.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
